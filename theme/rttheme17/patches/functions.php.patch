+    <script>
+    function toggleLabdooChat() {
+        var iframe = document.getElementById('labdoo-chat-iframe');
+        var label  = document.getElementById('labdoo-chat-label');
+        var logo   = document.getElementById('labdoo-logo-img');
+        var close  = document.getElementById('labdoo-close-icon');
+
+        if (iframe.style.display === 'block') {
+            // Close
+            iframe.style.display = 'none';
+            label.style.display  = 'block';
+            logo.style.display   = 'block';
+            close.style.display  = 'none';
+        } else {
+            // Open — force position every time in case theme JS moved it
+            iframe.style.setProperty('position', 'fixed',  'important');
